<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:Demo.ViewModels"
             x:DataType="vm:MainViewModel"             
             x:Class="Demo.Views.HomeView">
    <Grid RowDefinitions="250, *">
        <StackPanel Grid.Row="0"
            Background="#D2F6E7">
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="10"
                Margin="0,15,0,0">

                <Image
                    Height="50"
                    Source="avares:/Assets/Images/Чудо Обувь.png"></Image>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="Чудо-обувь"></TextBlock>                
            </StackPanel>            
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="10">
                <TextBlock 
                    Text="Каталог товаров" 
                    TextAlignment="Center"
                    FontSize="24"
                    Margin="15">
                </TextBlock>                
            </StackPanel>



            <TextBlock IsVisible="{Binding !Auth}" Margin="0,15,15,15"></TextBlock>
            <TextBlock
                HorizontalAlignment="Right"
                Margin="0,15,15,15"
                IsVisible="{Binding Auth}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Здраствуйте, {1} {0} {2}.">
                        <Binding Path="User.Name" />
                        <Binding Path="User.Surname" />
                        <Binding Path="User.Patronymic"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Grid ColumnDefinitions="Auto, Auto, *">
                    <ComboBox Grid.Column="0" 
                        SelectedItem="{Binding SelectedCost}"
                        PlaceholderText="По цене"
                        Margin="10,0,10,0">
                        <ComboBoxItem>По возрастанию</ComboBoxItem>
                        <ComboBoxItem>По убыванию</ComboBoxItem>                    
                    </ComboBox>
                    <ComboBox Grid.Column="1"
                        Margin="10,0,10,0">
                    
                    </ComboBox>
                    <Button
                        Grid.Column="2"
                        IsVisible="{Binding Auth}"
                        HorizontalAlignment="Right"
                        Content="Выйти"
                        Command="{Binding ExitCommand}"
                        Margin="0,0,15,0">
                    </Button>
                    <Button
                        Grid.Column="2"
                        IsVisible="{Binding !Auth}"
                        HorizontalAlignment="Right"
                        Content="Войти"
                        Command="{Binding LoginPageCommand}"
                        Margin="0,0,15,0">
                    </Button>                
            </Grid>


        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding ProductsDb}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BorderBrush="{Binding brush}"
                            BorderThickness="2"
                            CornerRadius="3"
                            BoxShadow="5 5 10 0 DarkGray"
                            Padding="8" Margin="5">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                
                                <StackPanel Grid.Column="0">
                                    <Image
                                        Source="{Binding Image, Converter={StaticResource ImagePathConverter}}"
                                        Width="170" 
                                        Height="170"></Image>                               
                                </StackPanel>

                                <StackPanel Grid.Column="1">
							        <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                                        <TextBlock Text="{Binding IdManufactureNavigation.Name}"></TextBlock>
								        <TextBlock Text=" | "></TextBlock>
                                        <TextBlock Text="{Binding Name}"></TextBlock>

							        </TextBlock>							
                                    <TextBlock Text="{Binding IdCategoryNavigation.Name, StringFormat=Категория: {0}}"></TextBlock>
							        <TextBlock Text="{Binding stringTotal, StringFormat=Количество: {0}}"></TextBlock>
							        <TextBlock Text="{Binding Structure, StringFormat=Состав: {0}}" TextWrapping="Wrap"></TextBlock>								
                                </StackPanel>
                             
                                <StackPanel 
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock 
                                        VerticalAlignment="Center" 
                                        TextAlignment="Right"
                                        Padding="0,0,10,0"
                                        FontSize="18"
                                        Text="{Binding Price, StringFormat={}{0:C}}"
                                        TextDecorations="{Binding decoration}"></TextBlock>
    					            <TextBlock                                    
                                        VerticalAlignment="Center" 
                                        TextAlignment="Right"
                                        Padding="0,0,50,0"
                                        FontSize="18"
                                        Text="{Binding priceSale, StringFormat={}{0:C}}"></TextBlock>                                
                                </StackPanel>

                            </Grid>
                        </Border>
     
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>            
        </ScrollViewer>
    </Grid>
</UserControl>
